#!/bin/bash

PID_FILE="${TRIM_PKGVAR}/fndns.pid"
BINARY="${TRIM_APPDEST}/bin/fndns"
SOCKET_PATH="${TRIM_APPDEST}/fndns.sock"

if [ -f "$PID_FILE" ]; then
  pid="$(cat "$PID_FILE" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    executable="$(readlink "/proc/${pid}/exe" 2>/dev/null)"
    case "$executable" in
      "$BINARY"|"$BINARY (deleted)")
        kill "$pid" 2>/dev/null || true
        count=0
        while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 15 ]; do
          sleep 1
          count=$((count + 1))
        done
        ;;
    esac
  fi
fi

rm -f "$PID_FILE" "$SOCKET_PATH"
exit 0
